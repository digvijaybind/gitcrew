    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "^8.0.1",
    "@fastify/swagger": "^9.3.1",
    "@fastify/swagger-ui": "^5.0.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
